    "idle.scope.appHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fires when the target app has been out of the foreground for the specified duration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标应用未处于前台达指定时长后触发。"
          }
        }
      }
    },
    "idle.scope.systemHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fires when the entire system has had no keyboard/mouse input for the specified duration (global idle, e.g. when you step away)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整个系统无键盘/鼠标输入达指定时长后触发（全局闲置，例如离开电脑时）。"
          }
        }
      }
    },

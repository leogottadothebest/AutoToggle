    "AutoToggle": {},
    "AutoToggle 启动完成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AutoToggle started"
          }
        }
      }
    },
    "AutoToggle 将在菜单栏安静运行，不占用 Dock 空间。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AutoToggle runs quietly in the menu bar without taking up Dock space."
          }
        }
      }
    },
    "AutoToggle 通常无需额外权限，以下两项按需授权：": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AutoToggle normally needs no extra permissions. Grant the following two only when needed:"
          }
        }
      }
    },
    "AutoToggle 防止显示器休眠": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AutoToggle prevents display sleep"
          }
        }
      }
    },
    "AutoToggle 防止系统休眠": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AutoToggle prevents system sleep"
          }
        }
      }
    },
    "AutoToggle 需要以下权限来正常工作：": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AutoToggle needs the following permission to work properly:"
          }
        }
      }
    },

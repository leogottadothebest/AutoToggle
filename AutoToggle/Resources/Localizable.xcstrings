    "editor.quitStrategyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal: AppleScript quit only. Force: three-level fallback (AppleScript → terminate → force terminate)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通退出：仅 AppleScript 优雅退出。强制退出：三级降级（AppleScript → terminate → 强制终止）。「跟随全局」使用设置中的默认策略。"
          }
        }
      }
    },

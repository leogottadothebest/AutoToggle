<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 允许向其他应用发送 Apple Events（用于退出/隐藏目标应用）。
	     这是 Hardened Runtime 下控制其他应用所必需的自动化授权。 -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- 允许加载 Sparkle.framework。本 app 用自签名证书签名（无 Apple Team ID），
	     Library Validation 无法匹配框架与主程序的 Team ID（dyld 报 "different Team IDs"），
	     即使 Sparkle 已被 Xcode 用同一证书重签也会被拒绝。故必须关闭该校验，否则启动崩溃。
	     改用真实 Developer ID + 公证后可移除此授权。 -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
